<?xml version="1.0"?>
<!-- rh_p12_rn_a gripper -->

<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:macro name="rh_p12_rn_a_gripper" params="prefix">

    <xacro:property
      name="meshes_file_direction"
      value="package://rh_p12_rn_a_description/meshes"/>

    <!-- base -->
    <link name="${prefix}rh_p12_rn_base">
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="${meshes_file_direction}/base.stl" scale="0.001 0.001 0.001"/>
        </geometry>
      </collision>

      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="${meshes_file_direction}/base.stl" scale="0.001 0.001 0.001"/>
        </geometry>
                <material name="grey">
          <color rgba="0.2 0.2 0.2 1"/>
        </material>
      </visual>

      <inertial>
        <origin xyz="0.000 0.000 0.032" rpy="0 0 0"/>
        <mass value="0.236"/>
        <inertia ixx="0.000001" ixy="0.0" ixz="0.0" iyy="0.000001" iyz="0.0" izz="0.000001" />
      </inertial>
    </link>

    <!-- Joint -->
    <joint name="${prefix}rh_r1_joint" type="revolute">
      <parent link="${prefix}rh_p12_rn_base"/>
      <child link="${prefix}rh_p12_rn_r1"/>
      <origin xyz="0.0 0.008 0.048" rpy="0 0 0"/>
      <axis xyz="1 0 0"/>
      <limit velocity="1.0" effort="5" lower="-0.1" upper="1.1"/>
      <dynamics damping="5.0"/>
    </joint>

    <!-- rh_p12_rn_r1 -->
    <link name="${prefix}rh_p12_rn_r1">
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="${meshes_file_direction}/r1.stl" scale="0.001 0.001 0.001"/>
        </geometry>
      </collision>

      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="${meshes_file_direction}/r1.stl" scale="0.001 0.001 0.001"/>
        </geometry>
                <material name="grey">
          <color rgba="0.2 0.2 0.2 1"/>
        </material>
      </visual>

      <inertial>
        <origin xyz="0.000 0.034 0.004" rpy="0 0 0"/>
        <mass value="0.068"/>
        <inertia ixx="0.000001" ixy="0.0" ixz="0.0" iyy="0.000001" iyz="0.0" izz="0.000001" />
      </inertial>
    </link>

    <!-- Right Joint 2 -->
    <joint name="${prefix}rh_r2" type="revolute">
      <parent link="${prefix}rh_p12_rn_r1"/>
      <child link="${prefix}rh_p12_rn_r2"/>
      <origin xyz="0.0 0.0493634 0.0285" rpy="0 0 0"/>
      <axis xyz="-1 0 0"/>
      <limit velocity="1.0" effort="5" lower="-0.1" upper="1.1" />
      <dynamics damping="5.0"/>
      <mimic joint="${prefix}rh_r1_joint" multiplier="1"/>
    </joint>

    <!-- rh_p12_rn_r2 -->
    <link name="${prefix}rh_p12_rn_r2">
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="${meshes_file_direction}/r2.stl" scale="0.001 0.001 0.001"/>
        </geometry>
      </collision>

      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="${meshes_file_direction}/r2.stl" scale="0.001 0.001 0.001"/>
        </geometry>
                <material name="grey">
          <color rgba="0.2 0.2 0.2 1"/>
        </material>
      </visual>

      <inertial>
        <origin xyz="0.000 0.006 0.011" rpy="0 0 0"/>
        <mass value="0.022"/>
        <inertia ixx="0.000001" ixy="0.0" ixz="0.0" iyy="0.000001" iyz="0.0" izz="0.000001" />
      </inertial>
    </link>

    <!-- Left Joint 1 -->
    <joint name="${prefix}rh_l1" type="revolute">
      <parent link="${prefix}rh_p12_rn_base"/>
      <child link="${prefix}rh_p12_rn_l1"/>
      <origin xyz="0.0 -0.008 0.048" rpy="0 0 0"/>
      <axis xyz="-1 0 0"/>
      <limit velocity="1.0" effort="5" lower="-0.1" upper="1.1" />
      <dynamics damping="5.0"/>
      <mimic joint="${prefix}rh_r1_joint" multiplier="1"/>
    </joint>

    <!-- rh_p12_rn_l1 -->
    <link name="${prefix}rh_p12_rn_l1">
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="${meshes_file_direction}/l1.stl" scale="0.001 0.001 0.001"/>
        </geometry>
      </collision>

      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="${meshes_file_direction}/l1.stl" scale="0.001 0.001 0.001"/>
        </geometry>
                <material name="grey">
          <color rgba="0.2 0.2 0.2 1"/>
        </material>
      </visual>

      <inertial>
        <origin xyz="0.000 -0.034 0.004" rpy="0 0 0"/>
        <mass value="0.068"/>
        <inertia ixx="0.000001" ixy="0.0" ixz="0.0" iyy="0.000001" iyz="0.0" izz="0.000001" />
      </inertial>
    </link>

    <!-- Left Joint 2 -->
    <joint name="${prefix}rh_l2" type="revolute">
      <parent link="${prefix}rh_p12_rn_l1"/>
      <child link="${prefix}rh_p12_rn_l2"/>
      <origin xyz="0.0 -0.0493634 0.0285" rpy="0 0 0"/>
      <axis xyz="1 0 0"/>
      <limit velocity="1.0" effort="5" lower="-0.1" upper="1.1" />
      <dynamics damping="5.0"/>
      <mimic joint="${prefix}rh_r1_joint" multiplier="1"/>
    </joint>

    <!-- rh_p12_rn_l2 -->
    <link name="${prefix}rh_p12_rn_l2">
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="${meshes_file_direction}/l2.stl" scale="0.001 0.001 0.001"/>
        </geometry>
      </collision>

      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="${meshes_file_direction}/l2.stl" scale="0.001 0.001 0.001"/>
        </geometry>
                <material name="grey">
          <color rgba="0.2 0.2 0.2 1"/>
        </material>
      </visual>

      <inertial>
        <origin xyz="0.000 -0.006 0.011" rpy="0 0 0"/>
        <mass value="0.022"/>
        <inertia ixx="0.000001" ixy="0.0" ixz="0.0" iyy="0.000001" iyz="0.0" izz="0.000001" />
      </inertial>
    </link>

    <!-- Gripper end effector joint -->
    <joint name="${prefix}rh_p12_rn_ee_joint" type="fixed">
      <origin xyz="0.0 0.0 0.125" rpy="0 0 0"/>
      <parent link="${prefix}rh_p12_rn_base"/>
      <child link="${prefix}rh_p12_rn_ee"/>
    </joint>

    <!-- Gripper end effector link (TCP / grasp frame used by IK).
         Intentionally has no visual, since it is just a coordinate frame
         and not a real body. The old 1 cm red box rendered at the
         fingertips and the overhead camera detected it as a stray red
         object, so the visual is removed. The frame and its inertial stay
         intact for TF and kinematics.
         (Keep this comment free of a colon-then-space, or the sim launch
         YAML-parse of robot_description will choke.) -->
    <link name="${prefix}rh_p12_rn_ee">
      <inertial>
        <origin xyz="0 0 0" />
        <mass value="1.0e-03" />
        <inertia ixx="1.0e-03" ixy="0.0" ixz="0.0"
                iyy="1.0e-03" iyz="0.0"
                izz="1.0e-03" />
      </inertial>
    </link>

    <!--
      OVERHEAD CAMERA (was gripper-mounted).
      Fixed to base_link (the arm base is bolted to the world, so this is
      a static, non-moving overhead view) instead of the gripper, so the
      objects are localized once from a stable top-down view instead of
      from the moving gripper.

      Pose is expressed in base_link, using REP-103 axes where
      X points forward toward the table, Y left, Z up.
        xyz -> position of the camera above the workspace. TUNE THIS
               line while watching rqt_image_view until all boxes are
               centered in frame. x around 0.4 sits it over the boxes,
               z around 0.8 lifts it well above them.
        rpy -> "0 1.5708 0" pitches the link's +X axis to point straight
               down (toward -Z), so the camera looks down at the table.
      NOTE keep comments free of a colon-followed-by-space here. The sim
      launch parses the whole robot_description as YAML, and anything that
      looks like a YAML mapping key inside a comment breaks that parse.
    -->
    <joint type="fixed" name="${prefix}overhead_camera_joint">
      <origin xyz="0.0 0.38 0.8" rpy="0 1.5708 0"/>
      <parent link="${prefix}base_link"/>
      <child link="${prefix}overhead_camera_link"/>
    </joint>

    <link name="${prefix}overhead_camera_link">
      <inertial>
        <mass value="0.001"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <inertia ixx="1e-6" ixy="0" ixz="0" iyy="1e-6" iyz="0" izz="1e-6"/>
      </inertial>
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <box size="0.02 0.02 0.02"/>
        </geometry>
        <material name="blue">
          <color rgba="0.0 0.0 0.8 1.0"/>
        </material>
      </visual>
    </link>

    <joint type="fixed" name="${prefix}overhead_camera_optical_joint">
      <origin xyz="0 0 0" rpy="-1.5707 0 -1.5707"/>
      <parent link="${prefix}overhead_camera_link"/>
      <child link="${prefix}overhead_camera_optical_link"/>
    </joint>

    <link name="${prefix}overhead_camera_optical_link"/>

  </xacro:macro>
</robot>
